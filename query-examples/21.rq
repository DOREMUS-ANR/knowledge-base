PREFIX mus: <http://data.doremus.org/ontology#>
PREFIX ecrm: <http://erlangen-crm.org/current/>
PREFIX efrbroo: <http://erlangen-crm.org/efrbroo/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX time: <http://www.w3.org/2006/time#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# [en] Give me a list of melodies of 20th century about gastronomy
# [fr] Donne-moi une liste de mélodies du XXème siècle autour de la gastronomie

SELECT DISTINCT ?expression (SAMPLE(?title_raw) as ?title) ?start ?end
WHERE {
  ?expression a efrbroo:F22_Self-Contained_Expression ;
          rdfs:label ?title_raw ;
          mus:U12_has_genre <http://data.doremus.org/vocabulary/iaml/genre/mld> .

  ?expCreation efrbroo:R17_created ?expression ;
          ecrm:P4_has_time-span ?ts .
  ?ts time:hasEnd / time:inXSDDate ?end ;
          time:hasBeginning / time:inXSDDate ?start .

  FILTER ( ?start >= "1900"^^xsd:gYear && ?end < "2000"^^xsd:gYear )
}
GROUP BY ?expression ?start ?end
ORDER BY ?start

