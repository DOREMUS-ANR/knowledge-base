# doremus-kb staging/production settings. Copy to .env and fill the secrets.
# .env is chmod 600 and never committed.

# Engine (loopback in staging; the workbench is the public component)
QLEVER_PORT=8863
QLEVER_BIND_ADDRESS=127.0.0.1

# Privileged engine operations only (runtime settings, cache pinning, clears)
QLEVER_ACCESS_TOKEN=generate-with-openssl-rand-hex-24

QLEVER_INDEX_MEMORY=4G
QLEVER_MEMORY_FOR_QUERIES=16G
QLEVER_CACHE_MAX_SIZE=2G
QLEVER_QUERY_TIMEOUT=120s

# Workbench
WORKBENCH_PORT=8862
WORKBENCH_ADMIN_USER=dba
WORKBENCH_ADMIN_PASSWORD=at-least-12-characters
WORKBENCH_URL=https://data.doremus.org

# Slug paths the workbench serves at /<path>/<id>; from the Phase 1 namespace
# scan of the merged dumps (dumps/counts/namespace-paths.txt)
DEREFERENCE_PATHS=artist,manifestation,event,performance,expression,publication,work,recording,activity,vocabulary,editing,track,organization,place,source,time,context,support,actor,characters,entity,theme,categorization,period,mop,genre,format,audience,function,philharmonie,itema3,euterpe,diabolo,bnf
